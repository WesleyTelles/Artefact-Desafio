# Copie para .env e preencha. Nunca commite o .env.
# Provedor: gemini (padrão, plano gratuito), groq, ollama ou mock (sem chave, demonstração)
LLM_PROVIDER=gemini
# Opcional: sobrescreve o modelo padrão do provedor
LLM_MODEL=
# Chave do provedor (gemini/groq). Ollama local não precisa de chave real.
LLM_API_KEY=
# Opcional: sobrescreve o endereço compatível com OpenAI do provedor
LLM_BASE_URL=
