# Copie para .env e preencha. Nunca commite o .env.
# Provedor: gemini (padrão, plano gratuito), groq, ollama ou mock (sem chave, demonstração)
LLM_PROVIDER=gemini
# Opcional: sobrescreve o modelo padrão do provedor
LLM_MODEL=
# Chave do provedor (gemini/groq). Ollama local não precisa de chave real.
LLM_API_KEY=
# Opcional: sobrescreve o endereço compatível com OpenAI do provedor
LLM_BASE_URL=
# Opcional: total de chamadas ao provedor por pedido, incluindo tentativas (1 a 10; padrão 3)
LLM_MAX_ATTEMPTS=
# Opcional: arquivo do log JSONL por turno (sem texto do cliente); desligado quando vazio
EMPORIO_LOG_FILE=
# Opcional: pasta com os CSVs e o PDF do manual (padrão: data/)
EMPORIO_DATA_DIR=
